<div data-controller="sprint-picker">
  <div class="flex gap-2">
    <%= f.date_field :start_date, required: true, disabled: locked, class: ds_field(width: "w-1/2"), data: { sprint_picker_target: "startInput" } %>
    <%= f.date_field :end_date, required: true, disabled: locked, class: ds_field(width: "w-1/2"), data: { sprint_picker_target: "endInput" } %>
  </div>
  <% unless locked %>
    <p class="text-xs text-gray-400 mt-1 mb-1">…or set them from sprints instead:</p>
    <div class="grid grid-cols-2 gap-2">
      <select data-sprint-picker-target="fromSelect" data-action="change->sprint-picker#apply" class="text-xs">
        <option value="">From sprint&hellip;</option>
        <% sprints.each do |sprint| %>
          <option value="<%= sprint.start_date.iso8601 %>">Sprint <%= sprint.number %> (<%= sprint.start_date.strftime("%b %-d") %>)</option>
        <% end %>
      </select>
      <select data-sprint-picker-target="toSelect" data-action="change->sprint-picker#apply" class="text-xs">
        <option value="">To sprint&hellip;</option>
        <% sprints.each do |sprint| %>
          <option value="<%= sprint.end_date.iso8601 %>">Sprint <%= sprint.number %> (ends <%= sprint.end_date.strftime("%b %-d") %>)</option>
        <% end %>
      </select>
    </div>
  <% end %>
</div>
