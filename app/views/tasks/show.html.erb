<%= turbo_frame_tag "modal_body" do %>
  <div class="p-4 space-y-4" data-controller="item-form">
    <%= render "shared/modal_header", title: safe_join([ tag.span("▬", style: "color: #{@task.team&.color || '#3b82f6'}"), @task.name ], " ") %>
    <p class="text-xs text-gray-500"><%= @task.project.name %></p>
    <p data-item-form-target="error" class="<%= ds_alert(:error) %>" hidden></p>

    <p data-item-form-target="lockNotice" class="text-xs text-gray-400" <%= "hidden" unless @task.verified? %>>
      Verified — title and dates are locked. Un-check "Verified" below to edit them.
    </p>

    <%= form_with model: [ @task.project, @task ], data: { action: "submit->item-form#save" }, class: "space-y-2" do |f| %>
      <%= f.text_field :name, required: true, disabled: @task.verified?, class: ds_field, data: { item_form_target: "lockable" } %>
      <%= render "team_picker", f: f, teams: @teams %>
      <%= render "sprint_picker", f: f, sprints: @sprints, locked: @task.verified? %>
      <label class="flex items-center gap-1.5 text-xs text-gray-600">
        <%= f.check_box :verified, data: { action: "change->item-form#toggleLock" } %> Verified
      </label>
      <%= f.text_area :notes, placeholder: "Notes (optional)", rows: 3, class: ds_field %>
      <div class="flex justify-end">
        <%= f.submit "Save", class: ds_button(:primary) %>
      </div>
    <% end %>

    <div class="border-t border-gray-100 pt-3">
      <%= button_to "Delete task", [ @task.project, @task ], method: :delete, data: { turbo_confirm: "Delete this task?", turbo_frame: "_top" }, class: ds_button(:danger_text) %>
    </div>
  </div>
<% end %>
