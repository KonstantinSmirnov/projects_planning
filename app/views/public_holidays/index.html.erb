<%= turbo_frame_tag "modal_body" do %>
  <div class="p-4 space-y-4">
    <%= render "shared/modal_header", title: @filter_date ? "Holidays on #{@filter_date.strftime('%B %-d, %Y')}" : "Public holidays" %>

    <% if @filter_date %>
      <p class="text-xs text-gray-500">
        <%= pluralize(@holidays.size, "holiday") %> on this date.
        <%= link_to "View all holidays", public_holidays_path, data: { turbo_frame: "modal_body" }, class: "text-indigo-600 hover:underline" %>
      </p>
    <% else %>
      <p class="text-xs text-gray-500">
        <%= pluralize(@holidays.size, "holiday") %> between <%= @start_date.iso8601 %> and <%= @end_date.iso8601 %>.
        Toggle "Holidays" in the chart's toolbar to show or hide them on the timeline.
      </p>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-600">
        <% PublicHoliday::REGIONS.each do |code, label| %>
          <span class="flex items-center gap-1">
            <span class="inline-block w-2.5 h-2.5 rounded-full <%= PublicHoliday::REGION_COLORS.fetch(code) %>"></span>
            <%= label %>
          </span>
        <% end %>
      </div>
    <% end %>

    <div class="border border-gray-200 rounded overflow-hidden">
      <div class="grid grid-cols-[6rem_1fr_7rem] gap-x-2 items-center bg-gray-50 border-b border-gray-200 px-3 py-2 text-xs uppercase tracking-wide text-gray-500">
        <span>Date</span>
        <span>Holiday</span>
        <span>Region</span>
      </div>

      <div class="max-h-[50vh] overflow-y-auto divide-y divide-gray-100">
        <% if @holidays.empty? %>
          <p class="px-3 py-4 text-sm text-gray-400">No holidays found in this range.</p>
        <% end %>
        <% @holidays.each do |holiday| %>
          <div class="grid grid-cols-[6rem_1fr_7rem] gap-x-2 items-center px-3 py-1.5 text-sm hover:bg-gray-50">
            <span class="text-gray-500 text-xs"><%= holiday.date.iso8601 %></span>
            <span class="text-gray-800 truncate"><%= holiday.name %></span>
            <span class="flex items-center gap-1.5 text-xs text-gray-600">
              <span class="inline-block w-2 h-2 rounded-full shrink-0 <%= holiday.region_color %>"></span>
              <%= holiday.region_label %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
