<%= turbo_frame_tag "modal_body" do %>
  <div class="p-4 space-y-4">
    <%= render "shared/modal_header", title: "Sprint #{@sprint.number}" %>

    <div>
      <div class="flex justify-between text-xs text-gray-500 mb-1">
        <span><%= @sprint.start_date.strftime("%b %-d, %Y") %> &rarr; <%= @sprint.end_date.strftime("%b %-d, %Y") %></span>
        <span><%= @progress_percent %>% complete</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2">
        <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= @progress_percent %>%"></div>
      </div>
    </div>

    <p class="text-xs text-gray-400 border-t border-gray-100 pt-3">
      To change this sprint's dates, or where sprint numbering starts, use <%= link_to "Sprints configuration", sprints_path, data: { turbo_frame: "modal_body" }, class: "text-indigo-600 hover:underline" %>.
    </p>

    <div class="border-t border-gray-100 pt-3">
      <h4 class="<%= ds_section_label %> mb-2">Work in this sprint</h4>
      <% if @project_rows.empty? %>
        <p class="text-sm text-gray-400">Nothing scheduled in this sprint.</p>
      <% else %>
        <div class="space-y-3">
          <% @project_rows.each do |row| %>
            <div>
              <p class="text-sm font-medium text-gray-800"><%= row[:project].name %></p>
              <ul class="text-sm text-gray-600 ml-4 list-disc">
                <% row[:tasks].each do |task| %>
                  <li><%= task.name %> <span class="text-xs text-gray-400">(<%= task.start_date.strftime("%b %-d") %>&ndash;<%= task.end_date.strftime("%b %-d") %>)</span></li>
                <% end %>
                <% row[:milestones].each do |milestone| %>
                  <li><span class="text-amber-500">&#9670;</span> <%= milestone.name %> <span class="text-xs text-gray-400">(<%= milestone.date.strftime("%b %-d") %>)</span></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
